# Copy to .env.local. Nothing here is required to run or deploy the app today.

# Your machine's LAN address (e.g. 192.168.1.50), to play on a phone against `npm run dev`.
DEV_LAN_ORIGIN=

# Add these when connecting a Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
